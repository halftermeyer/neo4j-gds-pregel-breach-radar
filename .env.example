# Copy to .env. Used by docker-compose.yml, the Makefile and the Vite app (via vite.config.ts).
# Local Docker defaults below; point them at your own self-managed Neo4j + GDS if you prefer.
NEO4J_URI=bolt://127.0.0.1:7699
NEO4J_USER=neo4j
NEO4J_PASSWORD=breachradar-demo
NEO4J_DATABASE=neo4j
# Host ports published by docker-compose (7687/7474 are often taken by another local Neo4j)
NEO4J_BOLT_PORT=7699
NEO4J_HTTP_PORT=7498
NEO4J_IMAGE=neo4j:2026.09.0-enterprise
